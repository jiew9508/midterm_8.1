<article class="article-detail">
  <%= link_to "← Back to stories", articles_path, class: "back-link" %>
  <div class="detail-meta"><span class="post-category"><%= @article.topic %></span><span class="post-date"><%= @article.created_at.strftime("%B %d, %Y") %></span></div>
  <h1><%= @article.title %></h1>
  <div class="article-body"><%= simple_format(@article.body) %></div>
  <div class="article-actions"><%= link_to "Edit post", edit_article_path(@article), class: "button button-outline" %><%= button_to "Delete post", article_path(@article), method: :delete, class: "button button-danger" %></div>
</article>
<section id="comments" class="comments-section">
  <div class="list-heading"><div><span class="eyebrow">LET'S TALK</span><h2>Reader comments</h2></div><span class="counter"><%= @article.comments.count %></span></div>
  <% @article.comments.order(created_at: :desc).each do |comment| %>
    <div class="comment"><div class="comment-header"><strong><%= comment.commenter %></strong><span><%= comment.created_at.strftime("%b %d, %Y") %></span></div><p><%= simple_format(comment.body) %></p><%= button_to "Remove comment", article_comment_path(@article, comment), method: :delete, class: "delete-link" %></div>
  <% end %>
  <% if @article.comments.none? %><p class="muted">No comments yet. Be the first.</p><% end %>
  <div class="comment-form"><h3>Add your thoughts</h3><%= form_with model: [@article, @article.comments.build] do |form| %><div class="field"><%= form.label :commenter, "Your name" %><%= form.text_field :commenter, required: true, maxlength: 60 %></div><div class="field"><%= form.label :body, "Your comment" %><%= form.text_area :body, required: true, rows: 4, maxlength: 2000 %></div><%= form.submit "Post comment", class: "button button-primary" %><% end %></div>
</section>
