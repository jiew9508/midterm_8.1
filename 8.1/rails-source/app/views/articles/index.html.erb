<section class="hero"><div class="hero-copy"><span class="eyebrow">PROJECT LOG · ET-718</span><h1>Build. Break.<br><em>Learn.</em></h1><p>Code experiments, cloud notes, and lessons from the workbench.</p><%= link_to "Log a new idea →", new_article_path, class: "button button-primary" %></div><div class="hero-deco" aria-hidden="true"><span>&gt;_</span><small>STATUS / ONLINE</small></div></section>
<section class="search-panel"><%= form_with url: articles_path, method: :get, local: true, class: "search-form" do %><%= text_field_tag :q, @query, placeholder: "Search notes and projects", aria: { label: "Search articles" } %><%= button_tag "Search", type: :submit, class: "button button-primary" %><% end %></section>
<section class="list-heading"><div><span class="eyebrow">BROWSE THE ARCHIVE</span><h2>Latest entries</h2></div><span class="counter"><%= pluralize(@articles.size, "entry") %></span></section>
<div class="filter-pills"><%= link_to "All topics", articles_path, class: (@selected_topic.blank? ? "pill active" : "pill") %><% Article::TOPICS.each do |topic| %><%= link_to topic, articles_path(topic: topic, q: @query), class: (@selected_topic == topic ? "pill active" : "pill") %><% end %></div>
<div class="article-grid"><%= render partial: "card", collection: @articles, as: :article %></div>
<% if @articles.empty? %><div class="empty-state">No posts match this search. Try another topic or keyword.</div><% end %>
